# ==============================================================================
# AetherDB Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual configuration.
# DO NOT commit real secrets or production keys to version control.

# Server & Network Configuration
PORT=8301
AETHERDB_CORS_ORIGIN=http://localhost:3000

# Authentication & Security
# Set to 'true' to enforce strict cryptographic token authentication.
AETHERDB_REQUIRE_AUTH=false

# Comma-separated list of accepted API keys in format: aether_sk_<tenant_id>_<secret>
# Required when AETHERDB_REQUIRE_AUTH=true
AETHERDB_API_KEYS=aether_sk_default_replace_with_secure_random_secret,aether_sk_tenantA_replace_with_secure_random_secret

# Observability
# Set to 'true' to expose /metrics without requiring an API key in strict mode
AETHERDB_PUBLIC_METRICS=false

# Client / SDK Configuration
AETHERDB_ENDPOINT=http://127.0.0.1:8301
AETHERDB_API_KEY=aether_sk_default_replace_with_secure_random_secret
AETHERDB_TENANT=default

# Validation Suite Keys (Used by scripts/validate_public_deployment.py)
AETHERDB_TEST_KEY_A=aether_sk_tenantA_replace_with_secure_random_secret
AETHERDB_TEST_KEY_B=aether_sk_tenantB_replace_with_secure_random_secret
